{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://minggui.dev/schema/life-event.v1.json",
  "title":"MingGuiLifeEvent",
  "type":"object",
  "required":["event_id","person_id","domain","event_type","source_id","temporal_precision"],
  "properties":{
    "event_id":{"type":"string"},
    "person_id":{"type":"string"},
    "domain":{"type":"string"},
    "event_type":{"type":"string"},
    "start_date":{"type":["string","null"]},
    "end_date":{"type":["string","null"]},
    "age_start":{"type":["number","null"],"minimum":0},
    "age_end":{"type":["number","null"],"minimum":0},
    "temporal_precision":{"enum":["year","month","day","range","approximate","unknown"]},
    "location_id":{"type":["string","null"]},
    "organization_id":{"type":["string","null"]},
    "subject_id":{"type":["string","null"]},
    "magnitude":{"type":["number","null"],"minimum":0,"maximum":1},
    "visibility":{"enum":["private-reported","local","national","international","unknown"]},
    "description_normalized":{"type":["string","null"],"maxLength":500},
    "source_id":{"type":"string"},
    "extraction_method":{"enum":["structured","rule","llm","human","imported"]},
    "confidence":{"type":"number","minimum":0,"maximum":1},
    "observable_from":{"type":["string","null"],"description":"Earliest date this fact was publicly/legitimately observable; used for leakage control."},
    "attributes":{"type":"object"}
  },
  "additionalProperties":false
}
